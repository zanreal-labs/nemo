{
  "name": "@zanreal/nemo",
  "version": "3.0.0",
  "keywords": [
    "Next.js",
    "Middleware",
    "Multiple middleware",
    "Pathname",
    "Route",
    "Path"
  ],
  "homepage": "https://zanreal.com/docs/oss/nemo",
  "bugs": {
    "url": "https://github.com/zanreal-labs/nemo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zanreal-labs/nemo.git",
    "directory": "packages/nemo"
  },
  "license": "MIT",
  "author": "Mateusz Janota <m.janota@zanreal.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "package.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup --clean --splitting",
    "clean": "rm -rf node_modules && rm -rf .turbo && rm -rf dist",
    "dev": "tsup --watch",
    "lint": "eslint \"**/*.ts*\"",
    "test": "bun test"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "require": "./dist/storage/index.js",
      "import": "./dist/storage/index.js"
    },
    "./storage/adapters/memory": {
      "types": "./dist/storage/adapters/memory.d.ts",
      "require": "./dist/storage/adapters/memory.js",
      "import": "./dist/storage/adapters/memory.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "path-to-regexp": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.20",
    "@swc/core": "^1.15.43",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "next": "16.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-only-warn": "^1.2.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-turbo": "^2.10.5",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.7",
    "globals": "^16.5.0",
    "prettier": "^3.9.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  },
  "peerDependencies": {
    "next": ">=13.0.0"
  },
  "publishConfig": {
    "provenance": true
  }
}
