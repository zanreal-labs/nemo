{
  "author": "Mateusz Janota <m.janota@zanreal.com>",
  "bugs": {
    "url": "https://github.com/zanreal-labs/nemo/issues"
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "husky": "^9.1.7",
    "turbo": "^2.10.5"
  },
  "homepage": "https://zanreal.com/docs/oss/nemo",
  "keywords": [
    "Next.js",
    "Middleware",
    "Multiple middleware",
    "Pathname",
    "Route",
    "Path"
  ],
  "license": "MIT",
  "name": "nemo",
  "packageManager": "bun@1.3.2",
  "publishConfig": {
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zanreal-labs/nemo.git"
  },
  "scripts": {
    "build": "turbo build",
    "clean": "turbo clean",
    "dev": "turbo dev --concurrency 20",
    "prepare": "husky",
    "release": "turbo build --filter='@zanreal/nemo' && changeset publish",
    "version-packages": "changeset version"
  },
  "trustedDependencies": [
    "@swc/core",
    "docs"
  ],
  "workspaces": [
    "packages/*",
    "apps/docs"
  ],
  "version": ""
}
